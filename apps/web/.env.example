# Copiar a `.env.local` y rellenar. `.env.local` NO se versiona.

# Dominio canónico. Alimenta sitemap.xml, robots.txt y las URL canónicas.
# Si se omite, se usa VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola.
NEXT_PUBLIC_SITE_URL=https://gym-platform-alpha.vercel.app

# --- Supabase ---
#
# Las dos variables de abajo son PÚBLICAS por diseño: viajan al navegador. La
# clave publicable no concede nada por sí sola; todo lo que se puede leer o
# escribir con ella lo decide RLS en la base.
NEXT_PUBLIC_SUPABASE_URL=https://dnclwawnjnzqqxgsuhpn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_b6PCtrjmTEXuAncc7F8hRA_MRN0mLzU

# NUNCA añadir aquí la clave `service_role`.
#
# Tiene BYPASSRLS: se salta todas las políticas de aislamiento entre gimnasios.
# Cualquier variable con prefijo NEXT_PUBLIC_ acaba en el paquete que descarga
# el navegador, así que publicarla ahí equivale a regalar la base entera. Si
# alguna vez hace falta en el servidor, va sin ese prefijo y solo en tareas que
# jamás se rendericen en cliente.
